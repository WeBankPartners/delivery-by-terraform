{
  "default-runtime": "runc",
  "ip-forward": true,
  "ip-masq": true,
  "iptables": true,
  "ipv6": false,
  "storage-driver": "overlay2", 
  "data-root": "/data/docker",
  "selinux-enabled": false,
  "bip": "192.168.0.1/24",
  "default-address-pools": [
    {
      "base": "192.168.0.0/16",
      "size": 24
    }
  ],
  "registry-mirrors": [
    "https://mirror.ccs.tencentyun.com"
  ]
}